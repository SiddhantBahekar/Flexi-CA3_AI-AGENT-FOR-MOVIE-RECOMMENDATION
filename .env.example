# ==============================================================================
# CineAgent Environment Configuration Template
# Copy this file as `.env` and fill in your private API keys.
# DO NOT commit your actual `.env` file to version control.
# ==============================================================================

# Groq Cloud API Key (for ultra-fast LPU movie recommendations & real-time reasoning)
# Obtain your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (for Gemini multi-turn conversational reasoning)
# Obtain your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
